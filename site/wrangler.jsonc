{
  "$schema": "../worker/node_modules/wrangler/config-schema.json",
  "name": "pokerbots-site",
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "." },
  "routes": [{ "pattern": "pokerbots.dev", "custom_domain": true }],
  "services": [{ "binding": "API", "service": "pokerbots-production" }]
}
